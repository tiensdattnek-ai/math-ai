{
  "name": "AI Gia Su Toan - Webchat (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash webchat/setup.sh",
  "postStartCommand": "bash webchat/start.sh",
  "waitFor": "postCreateCommand",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "AI Gia Su Toan Webchat",
      "protocol": "https",
      "onAutoForward": "openBrowser",
      "requireLocalPort": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
